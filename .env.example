# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-secret
DEBUG=true

# ------------------------------------------------------------------
# PostgreSQL
# Local docker-compose: postgresql+asyncpg://weddingapp:weddingapp@postgres:5432/weddingapp
# Railway: copy the DATABASE_URL from your Railway Postgres service (change postgres:// → postgresql+asyncpg://)
# ------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://weddingapp:weddingapp@postgres:5432/weddingapp

# ------------------------------------------------------------------
# Redis
# Local docker-compose: redis://redis:6379/0
# Railway: copy the REDIS_URL from your Railway Redis service
# ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------
# Cloudflare R2 (production) — replace MinIO for cloud deployment
# Get these from: Cloudflare Dashboard → R2 → Manage API Tokens
#
# S3_ENDPOINT_URL format: https://<account-id>.r2.cloudflarestorage.com
#
# Local MinIO (docker-compose only):
#   S3_ENDPOINT_URL=http://minio:9000
#   S3_ACCESS_KEY_ID=minioadmin
#   S3_SECRET_ACCESS_KEY=minioadmin
# ------------------------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=weddingapp
S3_REGION=auto

# ------------------------------------------------------------------
# OTP / SMS — MSG91 (https://msg91.com)
# OTP_PROVIDER: console (dev, prints to logs) | msg91 (production)
# ------------------------------------------------------------------
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=WDGAPP

# ------------------------------------------------------------------
# Razorpay — use test keys locally
# ------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------------
# Anthropic / Claude
# ------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------------
# Generative media provider
# GEN_PROVIDER: stub | fal | composite
# Use stub locally (no API calls). Switch to fal in production.
# ------------------------------------------------------------------
GEN_PROVIDER=stub
GEN_PROVIDER_API_KEY=

# fal.ai model selection (only used when GEN_PROVIDER=fal)
GEN_IMAGE_MODEL=fal-ai/flux/dev
GEN_VIDEO_MODEL=fal-ai/cogvideox-5b

# Cost per output in paise — set to match your fal.ai plan / negotiated rate
GEN_IMAGE_COST_PAISE=250
GEN_VIDEO_COST_PAISE=800

# Hard wall-clock budget for the full generate() call (submit + poll)
GEN_IMAGE_TIMEOUT_SECONDS=300
GEN_VIDEO_TIMEOUT_SECONDS=600
GEN_MAX_RETRIES=3

# ------------------------------------------------------------------
# Claude adapter limits
# ------------------------------------------------------------------
CLAUDE_MODERATION_TIMEOUT_SECONDS=30
CLAUDE_PROMPT_TIMEOUT_SECONDS=60
CLAUDE_MAX_RETRIES=3
